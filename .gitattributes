# Los alumnos usan Windows y el repositorio se clona en Windows, macOS y Linux.
# Forzamos LF en todo lo que se ejecuta o se importa, para que los CSV no lleguen
# con CRLF a Odoo y para que los .sh funcionen dentro de los contenedores Linux.
* text=auto eol=lf

*.csv   text eol=lf
*.py    text eol=lf
*.sh    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
Dockerfile text eol=lf

# Scripts de Windows, si algún día los hay
*.bat   text eol=crlf
*.ps1   text eol=crlf

# Binarios
*.png binary
*.jpg binary
*.pdf binary
