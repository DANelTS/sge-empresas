# Copia este fichero a .env (o ejecuta `cp .env.example .env`) y cambia las
# dos contraseñas. El fichero .env NO se sube al repositorio (está en .gitignore).
#
# Reglas para las contraseñas: sin espacios, sin #, sin $ y sin comillas.
# Se pasan a Odoo por línea de comandos y algunos caracteres romperían el comando.

# Usuario y contraseña de PostgreSQL. Odoo se conecta con ellos.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=cambia-esta-contrasena

# Contraseña maestra del gestor de bases de datos de Odoo (/web/database/manager).
# Es la que te piden al crear, duplicar, hacer copia de seguridad o restaurar.
ADMIN_PASSWD=cambia-esta-otra

# Puertos en tu equipo. Si el 8069 está ocupado, cambia ODOO_PUERTO (p. ej. 8070)
ODOO_PUERTO=8069
PG_PUERTO=5433

# Base de datos de la empresa y usuario administrador de Odoo.
# OJO: ODOO_CLAVE debe coincidir con la contraseña que pongas al usuario admin
# al crear la base de datos (si la creas desde la pantalla, la eliges tú).
ODOO_BD=empresa
ODOO_USUARIO=admin
ODOO_CLAVE=admin
